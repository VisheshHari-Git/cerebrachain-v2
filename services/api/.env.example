# Paths must point to protected external storage. Do not commit a populated .env file.
CEREBRACHAIN_MODEL_CHECKPOINT=/secure/path/to/model_final.pth
CEREBRACHAIN_MODEL_SHA256=fb633c102af016310b89c6cb42f7cf65f78a3e63575cfe1a6075d14cd69b973f
CEREBRACHAIN_RESULT_STORAGE_DIR=/secure/path/to/cerebrachain-results
CEREBRACHAIN_INFERENCE_DEVICE=cpu
CEREBRACHAIN_MAX_UPLOAD_BYTES=67108864
CEREBRACHAIN_CPU_THREADS=0
# Set to 0.5 only when reproducing the legacy overlapping-window profile.
CEREBRACHAIN_SLIDING_WINDOW_OVERLAP=0.0
# PostgreSQL and JWT configuration must be supplied by the deployment environment.
# Leave these blank in the template. Never commit a populated .env file.
CEREBRACHAIN_DATABASE_URL=
CEREBRACHAIN_JWT_SECRET=
CEREBRACHAIN_JWT_ISSUER=zkp-cerebrachain-v2
CEREBRACHAIN_ACCESS_TOKEN_TTL_SECONDS=900
